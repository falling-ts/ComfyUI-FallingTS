# comfy-desktop-plugins 环境配置
# 复制此文件为 .env 并填写配置

# Volcengine API Key (必填)
# 从 https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey 获取
VOLC_ENGINE_API_KEY=your_api_key_here

# 可选: 覆盖默认模型 (不设置则使用代码中的默认配置)
# SEEDANCE_MODEL_NAME=Seedance 2.0 Mini
# SEEDANCE_MODEL_ID=doubao-seedance-2-0-mini-260615
